{
  "openapi": "3.0.0",
  "info": {
    "title": "Sherlocker Escrituras API",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://221b-api.sherlocker.com.br/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/escrituras/cpf/{cpf}": {
      "get": {
        "operationId": "getEscriturasByCpf",
        "summary": "Escrituras por CPF",
        "description": "Consulta **ao vivo** a CESDI (Central de Escrituras de Separações, Divórcios e Inventários) da CENSEC. A consulta é **assíncrona**: a resposta chega na hora com `statusUrl`, e o resultado fica pronto em 10 a 50 segundos em [`GET /escrituras/jobs/{jobId}`](/api-reference/escrituras/resultado-de-uma-consulta-de-escrituras). Cada escritura traz cartório, data, livro/folha, dados do casamento e todas as partes com CPF. Sem escrituras (`total: 0`) ou com falha da consulta, os tokens são estornados.",
        "tags": [
          "Escrituras"
        ],
        "parameters": [
          {
            "name": "cpf",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "12345678901"
            },
            "description": "CPF com ou sem máscara"
          }
        ],
        "responses": {
          "202": {
            "description": "Consulta enfileirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRef"
                },
                "example": {
                  "jobId": "3f2c1a9e-0000-4000-8000-000000000000",
                  "status": "processing",
                  "statusUrl": "/api/v1/escrituras/jobs/3f2c1a9e-0000-4000-8000-000000000000"
                }
              }
            }
          },
          "400": {
            "description": "CPF inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/escrituras/cnpj/{cnpj}": {
      "get": {
        "operationId": "getEscriturasByCnpj",
        "summary": "Escrituras por CNPJ",
        "description": "Consulta **ao vivo** a CESDI (Central de Escrituras de Separações, Divórcios e Inventários) da CENSEC. A consulta é **assíncrona**: a resposta chega na hora com `statusUrl`, e o resultado fica pronto em 10 a 50 segundos em [`GET /escrituras/jobs/{jobId}`](/api-reference/escrituras/resultado-de-uma-consulta-de-escrituras). Cada escritura traz cartório, data, livro/folha, dados do casamento e todas as partes com CPF. Sem escrituras (`total: 0`) ou com falha da consulta, os tokens são estornados.",
        "tags": [
          "Escrituras"
        ],
        "parameters": [
          {
            "name": "cnpj",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "11222333000181"
            },
            "description": "CNPJ com ou sem máscara"
          }
        ],
        "responses": {
          "202": {
            "description": "Consulta enfileirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRef"
                },
                "example": {
                  "jobId": "3f2c1a9e-0000-4000-8000-000000000000",
                  "status": "processing",
                  "statusUrl": "/api/v1/escrituras/jobs/3f2c1a9e-0000-4000-8000-000000000000"
                }
              }
            }
          },
          "400": {
            "description": "CNPJ inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/escrituras/jobs/{jobId}": {
      "get": {
        "operationId": "getEscriturasJob",
        "summary": "Resultado de uma consulta de escrituras",
        "tags": [
          "Escrituras"
        ],
        "description": "Consulte até `status` ser `completed` (resultado em `result`) ou `failed` (motivo em `error`). Enquanto a consulta roda, `status` é `waiting` ou `active`; um intervalo de 5 a 10 segundos entre as consultas é suficiente. Gratuito. O resultado fica disponível por 24 horas.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "`jobId` devolvido pela consulta por CPF ou CNPJ"
          }
        ],
        "responses": {
          "200": {
            "description": "Status e, quando concluído, o resultado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                },
                "examples": {
                  "concluido": {
                    "summary": "Concluído",
                    "value": {
