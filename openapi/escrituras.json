    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Parte": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "nullable": true,
            "description": "Nome como registrado no ato. Menor de idade: `[Menor de Idade, Protegido pela LGPD]`."
          },
          "cpf_cnpj": {
            "type": "string",
            "nullable": true,
            "description": "CPF ou CNPJ sem máscara. Menor de idade: `***.***.***-**`."
          },
          "qualidade": {
            "type": "string",
            "nullable": true,
            "description": "Papel no ato, como a CENSEC registra: `Falecido`, `Herdeiro`, `Viuvo`, `Inventariante`, `Divorciando`, `Separando`, `Advogado`, `Cedente`, `Anuente` etc."
          },
          "data_nascimento": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "sexo": {
            "type": "string",
            "nullable": true,
            "example": "F"
          },
          "estrangeiro": {
            "type": "boolean",
            "nullable": true
          },
          "conjuge_tipo": {
            "type": "string",
            "nullable": true,
            "description": "Em divórcio e separação: `Conjuge1` ou `Conjuge2`."
          },
          "naturalidade_uf": {
            "type": "string",
            "nullable": true
          },
          "residencia": {
            "type": "object",
            "nullable": true,
            "properties": {
              "municipio": {
                "type": "string",
                "nullable": true
              },
              "uf": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "documentos": {
            "type": "array",
            "description": "Demais documentos (RG, OAB, passaporte). Vazio quando a parte é menor ou tem idade desconhecida (exceto advogado).",
            "items": {
              "type": "object",
              "properties": {
                "tipo": {
                  "type": "string",
                  "nullable": true,
                  "example": "Rg"
                },
                "numero": {
                  "type": "string",
                  "nullable": true
                },
                "uf": {
                  "type": "string",
                  "nullable": true
                }
              }
            }
          },
          "mascarado_motivo": {
            "type": "string",
            "description": "`menor_de_idade` quando nome e documentos foram protegidos (LGPD)."
          }
        }
      },
      "Cartorio": {
        "type": "object",
        "properties": {
          "cns": {
            "type": "string",
            "nullable": true,
            "description": "Código Nacional de Serventia (CNJ)."
          },
          "denominacao": {
            "type": "string",
            "nullable": true
          },
          "municipio": {
            "type": "string",
            "nullable": true
          },
          "uf": {
            "type": "string",
            "nullable": true
          },
          "ibge": {
            "type": "string",
            "nullable": true
          },
          "endereco": {
            "type": "object",
            "nullable": true,
            "properties": {
              "logradouro": {
                "type": "string",
                "nullable": true
              },
              "numero": {
                "type": "string",
                "nullable": true
              },
              "complemento": {
                "type": "string",
                "nullable": true
              },
              "bairro": {
                "type": "string",
                "nullable": true
              },
              "cep": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "telefones": {
            "type": "array",
            "description": "Somente telefones públicos do cartório.",
            "items": {
              "type": "object",
              "properties": {
                "numero": {
                  "type": "string"
                },
                "ramal": {
                  "type": "string",
                  "nullable": true
                },
                "tipo": {
                  "type": "string",
                  "nullable": true
                }
              }
            }
          }
        }
      },
      "Escritura": {
        "type": "object",
        "properties": {
          "ids_fonte": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Identificadores do ato na CENSEC. Mais de um quando o cartório enviou o mesmo ato em cargas diferentes."
          },
          "tipo": {
            "type": "string",
            "nullable": true,
            "description": "`Inventario`, `InventarioComMenorOuIncapaz`, `Partilha`, `Sobrepartilha`, `NomeacaoDeInventariante`, `DivorcioDireto`, `Separacao`, `ConversaoDeSeparacaoEmDivorcio`, `Reconciliacao`, `Retificacao`, `RetificacaoAtoNaoNotarial`."
          },
          "tipo_descricao": {
            "type": "string",
            "nullable": true,
            "example": "Inventário"
          },
          "data": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "description": "Data da lavratura."
          },
          "livro": {
            "type": "string",
            "nullable": true
          },
          "livro_complemento": {
            "type": "string",
            "nullable": true
          },
          "folha": {
            "type": "string",
            "nullable": true
          },
          "folha_complemento": {
            "type": "string",
            "nullable": true
          },
          "cartorio": {
            "$ref": "#/components/schemas/Cartorio"
          },
          "incluida_na_censec_em": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "qualidades_consultado": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Papéis do documento consultado neste ato."
          },
          "mne": {
            "type": "string",
            "nullable": true
          },
          "valor": {
            "nullable": true,
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "responsavel": {
            "type": "string",
            "nullable": true,
            "example": "Ambos cônjuges"
          },
          "numero_controle": {
            "type": "string",
            "nullable": true
          },
          "complementacao": {
            "type": "string",
            "nullable": true
          },
          "data_contrato": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "data_validade": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "data_casamento": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "regime_bens": {
            "type": "string",
            "nullable": true,
            "example": "Comunhão parcial"
          },
          "filhos_maiores": {
            "type": "integer",
            "nullable": true
          },
          "filhos_menores": {
            "type": "integer",
            "nullable": true
          },
          "existe_bem_e_direito": {
            "type": "boolean",
            "nullable": true
          },
          "bens_imoveis": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Bens informados no ato, no formato da CENSEC."
          },
          "referentes": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Atos referentes (ex.: retificações), no formato da CENSEC."
          },
          "partes": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/Parte"
            },
            "description": "Todas as partes do ato. `null` quando a CENSEC não devolveu o detalhe."
          }
        }
      },
      "EscriturasResponse": {
        "type": "object",
        "properties": {
          "documento": {
            "type": "string"
          },
          "tipo_documento": {
            "type": "string",
            "enum": [
              "cpf",
              "cnpj"
            ]
          },
          "fonte": {
            "type": "string",
            "example": "CENSEC/CESDI"
          },
          "consultado_em": {
            "type": "string",
            "format": "date-time"
          },
          "total": {
            "type": "integer",
            "description": "Escrituras distintas encontradas."
          },
          "possivelmente_truncado": {
            "type": "boolean",
            "description": "A CENSEC devolve no máximo 300 linhas por busca."
          },
          "cobertura": {
            "type": "string"
          },
          "escrituras": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Escritura"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "JobRef": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "example": "processing"
          },
          "statusUrl": {
            "type": "string",
            "example": "/api/v1/escrituras/jobs/3f2c1a9e-0000-4000-8000-000000000000"
          }
        }
      },
      "JobStatus": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "active",
              "completed",
              "failed"
            ]
          },
          "createdAt": {
            "type": "integer",
            "description": "Epoch em ms"
          },
          "finishedAt": {
            "type": "integer",
            "description": "Epoch em ms"
          },
          "result": {
            "$ref": "#/components/schemas/EscriturasResponse"
          },
          "error": {
            "type": "string",
            "description": "Presente quando `status` é `failed`."
          }
        }
      }
    }
  }
}
