                          {
                            "numero": "(69) 30000000",
                            "ramal": null,
                            "tipo": "Fixo"
                          }
                        ]
                      },
                      "incluida_na_censec_em": "2023-01-05T12:00:00+00:00",
                      "qualidades_consultado": [
                        "Herdeiro"
                      ],
                      "mne": null,
                      "valor": null,
                      "responsavel": null,
                      "numero_controle": null,
                      "complementacao": null,
                      "data_contrato": null,
                      "data_validade": null,
                      "data_casamento": null,
                      "regime_bens": null,
                      "filhos_maiores": null,
                      "filhos_menores": null,
                      "existe_bem_e_direito": null,
                      "bens_imoveis": [],
                      "referentes": [],
                      "partes": [
                        {
                          "nome": "JOSE EXEMPLO DA SILVA",
                          "cpf_cnpj": "98765432100",
                          "qualidade": "Falecido",
                          "data_nascimento": "1940-03-02",
                          "sexo": "M",
                          "estrangeiro": false,
                          "conjuge_tipo": null,
                          "naturalidade_uf": "MG",
                          "residencia": {
                            "municipio": "CIDADE EXEMPLO",
                            "uf": "RO"
                          },
                          "documentos": [
                            {
                              "tipo": "Rg",
                              "numero": "123456",
                              "uf": "RO"
                            }
                          ]
                        },
                        {
                          "nome": "MARIA EXEMPLO DA SILVA",
                          "cpf_cnpj": "12345678901",
                          "qualidade": "Herdeiro",
                          "data_nascimento": "1975-08-19",
                          "sexo": "F",
                          "estrangeiro": false,
                          "conjuge_tipo": null,
                          "naturalidade_uf": "RO",
                          "residencia": {
                            "municipio": "CIDADE EXEMPLO",
                            "uf": "RO"
                          },
                          "documentos": [
                            {
                              "tipo": "Rg",
                              "numero": "654321",
                              "uf": "RO"
                            }
                          ]
                        },
                        {
                          "nome": "[Menor de Idade, Protegido pela LGPD]",
                          "cpf_cnpj": "***.***.***-**",
                          "qualidade": "Herdeiro",
                          "data_nascimento": null,
                          "sexo": "M",
                          "estrangeiro": false,
                          "conjuge_tipo": null,
                          "naturalidade_uf": null,
                          "residencia": null,
                          "documentos": [],
                          "mascarado_motivo": "menor_de_idade"
                        },
                        {
                          "nome": "ADVOGADO EXEMPLO",
                          "cpf_cnpj": "11122233344",
                          "qualidade": "Advogado",
                          "data_nascimento": null,
                          "sexo": "M",
