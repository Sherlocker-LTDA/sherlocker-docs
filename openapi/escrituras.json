{
  "openapi": "3.0.0",
  "info": {
    "title": "Sherlocker Escrituras API",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://221b-api.sherlocker.com.br/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
