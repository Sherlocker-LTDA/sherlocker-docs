  "paths": {
    "/escrituras/cpf/{cpf}": {
      "get": {
        "operationId": "getEscriturasByCpf",
        "summary": "Escrituras por CPF",
        "description": "Consulta **ao vivo** a CESDI (Central de Escrituras de Separações, Divórcios e Inventários) da CENSEC. Devolve cada escritura com cartório, data, livro/folha, dados do casamento e **todas as partes com CPF**. A consulta leva de 10 a 50 segundos; para lotes use `?async=true`. Resultado guardado por 24 h. Sem escrituras, `total: 0` e os tokens são estornados.",
        "tags": [
          "Escrituras"
        ],
        "parameters": [
          {
            "name": "cpf",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "12345678901"
            },
            "description": "CPF com ou sem máscara"
          },
          {
            "name": "async",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "`true` responde 202 com `jobId` e `statusUrl` (`/escrituras/jobs/{jobId}`)."
          }
        ],
        "responses": {
          "200": {
            "description": "Escrituras encontradas (ou `total: 0`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EscriturasResponse"
                },
                "example": {
                  "documento": "12345678901",
                  "tipo_documento": "cpf",
                  "fonte": "CENSEC/CESDI",
                  "consultado_em": "2026-10-12T17:00:00.000Z",
                  "total": 1,
                  "possivelmente_truncado": false,
                  "cobertura": "Escrituras públicas de separação, divórcio e inventário lavradas em cartório e enviadas à CENSEC. Atos judiciais ficam nos tribunais e não aparecem aqui.",
                  "escrituras": [
                    {
                      "ids_fonte": [
                        "2b1f0c3e-0000-4000-8000-000000000001"
                      ],
                      "tipo": "Inventario",
                      "tipo_descricao": "Inventário",
