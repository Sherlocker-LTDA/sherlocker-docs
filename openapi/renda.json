{
  "openapi": "3.0.0",
  "info": {
    "title": "Sherlocker Renda API",
    "description": "Estimativa de renda mensal e classe social por CPF, por motor de regras determinístico.",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://221b-api.sherlocker.com.br/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/renda/cpf/{cpf}": {
      "get": {
        "operationId": "getRendaByCpf",
        "summary": "Renda e classe social por CPF",
        "description": "Estima a renda mensal do domicílio e da pessoa e a classe social equivalente ao Critério Brasil (ABEP 2026). Basta o CPF: vínculos formais, Bolsa Família, BPC, renda do setor censitário dos endereços (IBGE, Censo 2022), empresas e patrimônio são buscados internamente. Motor de regras determinístico, sem IA. Veja a [metodologia e os cortes de cada classe](/entidades/renda). Sem dados suficientes, responde `status: sem_dados` com `total: 0` e os tokens são estornados.",
        "tags": [
          "Renda"
        ],
        "parameters": [
          {
            "name": "cpf",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "12345678901"
            },
            "description": "CPF com ou sem máscara"
          }
        ],
        "responses": {
          "200": {
            "description": "Estimativa (ou `sem_dados`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RendaResponse"
                },
                "examples": {
                  "assalariado": {
                    "summary": "Vínculo de 4 a 10 SM em bairro de alta renda",
                    "value": {
                      "documento": "123.456.789-01",
                      "status": "estimado",
                      "total": 1,
                      "renda_estimada": {
                        "domiciliar_mensal": {
                          "central": 13593.71,
                          "minimo": 10189.61,
                          "maximo": 20401.91
                        },
                        "individual_mensal": {
                          "central": 9726,
                          "minimo": 6484,
                          "maximo": 16210
                        },
                        "em_salarios_minimos": {
                          "domiciliar": 8.39,
                          "individual": 6
                        },
                        "salario_minimo_referencia": 1621
                      },
                      "classificacao": {
                        "classe_social": "B1",
                        "classe_minima": "B2",
                        "classe_maxima": "B1",
                        "padrao": "abep_2026_renda_equivalente",
                        "faixa_renda": "4 a 10 SM",
                        "confianca": "media"
                      }
                    }
                  },
                  "bolsa_familia": {
                    "summary": "Família no Bolsa Família",
                    "value": {
                      "documento": "987.654.321-00",
                      "status": "estimado",
                      "total": 1,
                      "renda_estimada": {
                        "domiciliar_mensal": {
                          "central": 1288.22,
                          "minimo": 680,
                          "maximo": 2649.74
                        },
                        "individual_mensal": {
                          "central": null,
                          "minimo": null,
                          "maximo": null
                        },
                        "em_salarios_minimos": {
                          "domiciliar": 0.79,
                          "individual": null
                        },
                        "salario_minimo_referencia": 1621
                      },
                      "classificacao": {
                        "classe_social": "DE",
                        "classe_minima": "DE",
                        "classe_maxima": "C2",
                        "padrao": "abep_2026_renda_equivalente",
                        "faixa_renda": "até 2 SM",
                        "confianca": "alta"
                      }
                    }
                  },
                  "sem_dados": {
                    "summary": "Sem dados suficientes (tokens estornados)",
                    "value": {
                      "documento": "111.444.777-35",
                      "status": "sem_dados",
                      "total": 0,
                      "renda_estimada": null,
                      "classificacao": null
                    }
                  },
                  "cpf_invalido": {
                    "summary": "CPF inválido (tokens estornados)",
                    "value": {
                      "erro": "CPF invalido"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Base temporariamente indisponível (tokens estornados)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "erro": {
                      "type": "string",
                      "example": "Servico indisponivel"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ValoresMensais": {
        "type": "object",
        "properties": {
          "central": {
            "type": "number",
            "nullable": true
          },
          "minimo": {
            "type": "number",
            "nullable": true
          },
          "maximo": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "RendaResponse": {
        "type": "object",
        "properties": {
          "documento": {
            "type": "string",
            "description": "CPF formatado"
          },
          "status": {
            "type": "string",
            "enum": [
              "estimado",
              "sem_dados"
            ]
          },
          "total": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "0 quando sem dados (tokens estornados)"
          },
          "renda_estimada": {
            "type": "object",
            "nullable": true,
            "properties": {
              "domiciliar_mensal": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ValoresMensais"
                  }
                ],
                "description": "Renda mensal do domicílio em R$. `maximo` null = sem teto"
              },
              "individual_mensal": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ValoresMensais"
                  }
                ],
                "description": "Renda mensal da pessoa em R$ (vínculo formal ativo ou BPC); null quando não observada"
              },
              "em_salarios_minimos": {
                "type": "object",
                "properties": {
                  "domiciliar": {
                    "type": "number"
                  },
                  "individual": {
                    "type": "number",
                    "nullable": true
                  }
                }
              },
              "salario_minimo_referencia": {
                "type": "number",
                "description": "Salário mínimo usado na conversão"
              }
            }
          },
          "classificacao": {
            "type": "object",
            "nullable": true,
            "properties": {
              "classe_social": {
                "type": "string",
                "enum": [
                  "A",
                  "B1",
                  "B2",
                  "C1",
                  "C2",
                  "DE"
                ],
                "description": "Estrato equivalente ao Critério Brasil ABEP 2026 pela renda domiciliar"
              },
              "classe_minima": {
                "type": "string",
                "enum": [
                  "A",
                  "B1",
                  "B2",
                  "C1",
                  "C2",
                  "DE"
                ]
              },
              "classe_maxima": {
                "type": "string",
                "enum": [
                  "A",
                  "B1",
                  "B2",
                  "C1",
                  "C2",
                  "DE"
                ]
              },
              "padrao": {
                "type": "string",
                "enum": [
                  "abep_2026_renda_equivalente"
                ]
              },
              "faixa_renda": {
                "type": "string",
                "enum": [
                  "até 2 SM",
                  "2 a 4 SM",
                  "4 a 10 SM",
                  "10 a 20 SM",
                  "acima de 20 SM"
                ]
              },
              "confianca": {
                "type": "string",
                "enum": [
                  "alta",
                  "media",
                  "baixa"
                ]
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
