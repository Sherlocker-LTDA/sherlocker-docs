  "components": {
    "schemas": {
      "VinculoPessoa": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "documento",
              "cpf",
              "mae"
            ],
            "description": "Como o item foi ligado à pessoa consultada.\n\n- `documento`: CPF/CNPJ publicado pelo tribunal na parte do processo, ou execução com o mesmo número de um desses processos e executado de mesmo nome.\n- `cpf`: mandado do BNMP pelo CPF; execução no processo de um mandado do CPF com executado de mesmo nome; ou achada pela busca por CPF no SEEU.\n- `mae`: execução confirmada no SEEU por nome + nome completo da mãe, executado de mesmo nome."
          },
          "confianca": {
            "type": "string",
            "enum": [
              "alta",
              "media"
            ],
            "description": "Grau de confiança da vinculação.\n\n- `alta`: documento publicado pelo tribunal, CPF do mandado, CPF ou nome + mãe completa conferidos no SEEU.\n- `media`: documento censurado no processo, completado pelos dígitos visíveis + nome (candidato único)."
          },
          "detalhe": {
            "type": "string"
          }
        }
      },
      "ProcessoCriminal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "proc-1"
          },
          "numero": {
            "type": "string"
          },
          "tribunal": {
            "type": "string"
          },
          "classe": {
            "type": "string"
          },
          "categoria": {
            "type": "string",
            "description": "criminal, execucao-penal ou habeas-corpus"
          },
          "assuntos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "polo": {
            "type": "string",
            "nullable": true
          },
          "situacao": {
            "type": "string",
            "nullable": true
          },
          "orgao": {
            "type": "string",
            "nullable": true
          },
          "juiz": {
            "type": "string",
            "nullable": true
          },
          "data_ajuizamento": {
            "type": "string",
            "nullable": true
          },
          "ultima_movimentacao": {
            "type": "object",
            "nullable": true,
            "properties": {
              "data": {
                "type": "string"
              },
              "evento": {
                "type": "string"
              }
            }
          },
          "sinais": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "vinculo_pessoa": {
            "$ref": "#/components/schemas/VinculoPessoa"
          }
        }
      },
      "MandadoPrisao": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "mand-1"
          },
          "numero": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "example": "Mandado de Prisão"
          },
          "especie_prisao": {
            "type": "string",
            "nullable": true
          },
          "regime_prisional": {
            "type": "string",
            "nullable": true
          },
          "situacao": {
            "type": "string",
            "example": "Pendente de Cumprimento"
          },
          "vigente": {
            "type": "boolean",
            "description": "Pendente de cumprimento e dentro da validade"
          },
          "data_expedicao": {
            "type": "string",
            "nullable": true
          },
          "data_validade": {
            "type": "string",
            "nullable": true
          },
          "tipificacao_penal": {
            "type": "string",
            "nullable": true
          },
          "processo_numero": {
            "type": "string",
            "description": "Processo que expediu o mandado (liga o mandado ao processo ou à execução)"
          },
          "orgao": {
            "type": "string",
            "nullable": true
          },
          "tribunal": {
            "type": "string",
            "nullable": true
          },
