{
  "openapi": "3.0.0",
  "info": {
    "title": "Sherlocker Criminal API",
    "description": "Consulta criminal única por CPF ou CNPJ: processos criminais, mandados de prisão (BNMP), execuções penais (SEEU), documentos policiais e certidão da PF, ligados entre si.",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://221b-api.sherlocker.com.br/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/criminal/cpf/{cpf}": {
      "get": {
        "operationId": "getCriminalByCpf",
        "summary": "Consulta criminal por CPF",
        "description": "Devolve numa resposta só os processos criminais, mandados de prisão (BNMP), execuções penais (SEEU), documentos policiais e, sob pedido, a certidão da PF, já ligados entre si (`vinculos`) e agrupados por fato (`casos`).\n\nCada item traz `vinculo_pessoa` indicando como foi ligado à pessoa consultada.\n\nVeja [como os vínculos funcionam](/entidades/criminal).",
        "tags": [
          "Criminal"
        ],
        "parameters": [
          {
            "name": "cpf",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "12345678901"
            },
            "description": "CPF com ou sem máscara"
          },
          {
            "name": "confirmar",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Confirma as execuções ao vivo no SEEU por CPF e por nome + nome da mãe.\n\nCom `false`, a resposta sai mais rápido, mas execuções sem outra evidência de vínculo são descartadas."
          },
          {
            "name": "certidao",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Enfileira a certidão de antecedentes criminais da Polícia Federal e devolve `certidao_pf.poll_url` para acompanhar."
          }
        ],
        "responses": {
          "200": {
            "description": "Resumo, casos, listas por fonte, vínculos, fontes e avisos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CriminalResponse"
                },
                "examples": {
