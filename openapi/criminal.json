    "/criminal/cnpj/{cnpj}": {
      "get": {
        "operationId": "getCriminalByCnpj",
        "summary": "Consulta criminal por CNPJ",
        "description": "Processos criminais em que a empresa é parte (ex.: crime ambiental), no mesmo formato da consulta por CPF. Mandados, execuções e certidão não se aplicam a empresas e vêm com `status: nao_aplicavel` em `fontes`.",
        "tags": [
          "Criminal"
        ],
        "parameters": [
          {
            "name": "cnpj",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "12345678000190"
            },
            "description": "CNPJ com ou sem máscara"
          }
        ],
        "responses": {
          "200": {
            "description": "Resumo, casos, listas por fonte, vínculos, fontes e avisos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CriminalResponse"
                },
                "examples": {
                  "nada_encontrado": {
                    "summary": "Nada encontrado para a empresa",
                    "value": {
                      "documento": {
